      "input": "",
      "expected": false
    },
    {
      "name": "dot",
      "input": ".",
      "expected": false
    },
    {
      "name": "dotdot-embedded",
      "input": "foo..bar",
      "expected": false
    },
    {
      "name": "control-nul",
      "input": "a\u0000b",
      "expected": false
    },
    {
      "name": "del",
      "input": "ab",
      "expected": false
    },
    {
      "name": "leading-space",
      "input": " leadspace",
      "expected": false
    },
    {
      "name": "trailing-space",
      "input": "trailspace ",
      "expected": false
    },
    {
      "name": "number-input",
      "input": 123,
      "expected": false
    },
    {
      "name": "null-input",
      "input": null,
      "expected": false
