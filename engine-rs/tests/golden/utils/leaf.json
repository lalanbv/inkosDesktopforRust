  "infer_language": [
    {
      "name": "undefined",
      "expected": "zh"
    },
    {
      "name": "empty",
      "input": "",
      "expected": "zh"
    },
    {
      "name": "latin-only",
      "input": "A dark fantasy novel",
      "expected": "en"
    },
    {
      "name": "latin-words",
      "input": "hello world",
      "expected": "en"
    },
    {
      "name": "cjk-only",
      "input": "夜港账本",
      "expected": "zh"
    },
    {
      "name": "cjk-with-english-term",
      "input": "主角觉醒了 System 面板",
      "expected": "zh"
    },
    {
      "name": "english-with-incidental-cjk",
      "input": "这是一段中文 but mostly English content here",
      "expected": "en"
    }
  ],
  "to_posix_path": [
    {
      "name": "posix-unchanged",
      "input": "a/b/c",
      "expected": "a/b/c"
    },
    {
      "name": "abs-posix",
      "input": "/abs/path",
      "expected": "/abs/path"
    },
    {
      "name": "backslash",
      "input": "a\\b\\c",
      "expected": "a/b/c"
    },
    {
      "name": "windows-drive",
      "input": "C:\\Users\\inkos",
      "expected": "C:/Users/inkos"
    },
    {
      "name": "mixed",
      "input": "a\\b/c\\d",
      "expected": "a/b/c/d"
    },
    {
      "name": "empty",
      "input": "",
      "expected": ""
    },
    {
      "name": "root-bs",
      "input": "\\",
      "expected": "/"
    }
  ],
  "count_chapter_length": [
    {
      "name": "zh-plain",
      "input": {
        "content": "正文内容。",
        "mode": "zh_chars"
      },
      "expected": 5
    },
    {
      "name": "zh-strips-header",
      "input": {
        "content": "# 标题\n正文内容",
        "mode": "zh_chars"
      },
      "expected": 4
    },
    {
      "name": "zh-strips-frontmatter",
      "input": {
        "content": "---\ntitle: x\n---\n正文",
        "mode": "zh_chars"
      },
      "expected": 2
    },
    {
      "name": "zh-strips-fence",
      "input": {
        "content": "正文\n```\ncode\n```\n更多",
        "mode": "zh_chars"
      },
      "expected": 4
    },
    {
      "name": "zh-collapses-ws",
      "input": {
        "content": "a  b\tc\n\n d",
        "mode": "zh_chars"
      },
      "expected": 4
    },
    {
      "name": "zh-emoji-utf16",
      "input": {
        "content": "😀哈哈",
        "mode": "zh_chars"
      },
      "expected": 4
    },
    {
      "name": "en-words-basic",
      "input": {
        "content": "hello world foo",
        "mode": "en_words"
      },
      "expected": 3
    },
    {
      "name": "en-words-apostrophe",
      "input": {
        "content": "don't it's won't",
        "mode": "en_words"
      },
      "expected": 3
    },
    {
      "name": "en-words-strips-header",
      "input": {
        "content": "# Title\nA dark fantasy novel",
        "mode": "en_words"
      },
      "expected": 4
    },
    {
      "name": "en-words-empty",
      "input": {
        "content": "```\ncode only\n```",
        "mode": "en_words"
      },
      "expected": 0
    }
  ],
  "build_length_spec": [
