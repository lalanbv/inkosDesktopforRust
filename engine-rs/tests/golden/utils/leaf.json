{
  "derive_book_id": [
    {
      "name": "cjk-kept",
      "input": "夜港账本",
      "expected": "夜港账本"
    },
    {
      "name": "latin-punct-collapse",
      "input": " Harbor: Ledger! ",
      "expected": "harbor-ledger"
    },
    {
      "name": "dash-run-collapse",
      "input": "a---b",
      "expected": "a-b"
    },
    {
      "name": "leading-dash-trim",
      "input": "---lead",
      "expected": "lead"
    },
    {
      "name": "trailing-dash-trim",
      "input": "trail---",
      "expected": "trail"
    },
    {
      "name": "whitespace-only",
      "input": "   ",
      "expected": ""
    },
    {
      "name": "mixed-cjk-latin",
      "input": "仙帝 System 重生",
      "expected": "仙帝-system-重生"
    },
    {
      "name": "emoji-stripped",
      "input": "📚Book Title🎉",
      "expected": "book-title"
    },
    {
      "name": "truncate-long",
      "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "expected": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    {
      "name": "numbers-kept",
      "input": "Book 123 Chapter 456",
      "expected": "book-123-chapter-456"
    },
    {
      "name": "uppercase-lowercased",
      "input": "UPPER Case",
      "expected": "upper-case"
    }
  ],
  "is_safe_book_id": [
    {
      "name": "valid-latin",
      "input": "harbor-ledger",
