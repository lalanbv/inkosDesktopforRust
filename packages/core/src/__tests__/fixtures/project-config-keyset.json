{
  "daemon": {
    "chaptersPerCycle": 1,
    "cooldownAfterChapterMs": 10000,
    "maxChaptersPerDay": 50,
    "maxConcurrentBooks": 3,
    "qualityGates": {
      "maxAuditRetries": 2,
      "pauseAfterConsecutiveFailures": 3,
      "retryTemperatureStep": 0.1
    },
    "retryDelayMs": 30000,
    "schedule": {
      "radarCron": "0 */6 * * *",
      "writeCron": "*/15 * * * *"
    }
  },
  "detection": {
    "apiKeyEnv": "DETECTOR_API_KEY",
    "apiUrl": "https://detector.example.com/v1",
    "autoRewrite": true,
    "enabled": false,
    "maxRetries": 3,
    "protectedNames": [
      "fixture-name"
    ],
    "provider": "custom",
    "threshold": 0.8
  },
  "foundation": {
    "reviewRetries": 2
  },
  "language": "zh",
  "llm": {
    "apiFormat": "chat",
    "apiKey": "",
    "baseUrl": "http://127.0.0.1:9",
    "configSource": "env",
    "cover": {
      "baseUrl": "https://cover.example.com/v1",
      "model": "fixture-cover-model",
      "service": "kkaiapi"
    },
    "defaultModel": "fixture-model",
    "model": "m",
    "provider": "custom",
    "service": "custom",
    "services": [
      {
        "apiFormat": "chat",
        "baseUrl": "https://svc.example.com/v1",
        "name": "FixtureSvc",
        "service": "custom",
        "stream": true,
        "temperature": 0.5
      }
    ],
    "stream": true,
    "temperature": 0.7,
    "thinkingBudget": 0
  },
  "modelOverrides": {
    "auditor": {
      "model": "fixture-model-c",
      "provider": "custom",
      "stream": false
    },
    "reviser": "fixture-model-b"
  },
  "name": "fixture",
  "notify": [
    {
      "botToken": "fixture-placeholder",
      "chatId": "fixture-chat",
      "format": "markdown",
      "type": "telegram"
    },
    {
      "format": "markdown",
      "type": "wechat-work",
      "webhookUrl": "https://wechat.example.com/hook"
    },
    {
      "format": "markdown",
      "type": "feishu",
      "webhookUrl": "https://feishu.example.com/hook"
    },
    {
      "events": [
        "chapter"
      ],
      "format": "markdown",
      "secret": "fixture-secret",
      "type": "webhook",
      "url": "https://webhook.example.com/hook"
    }
  ],
  "researchSearch": {
    "apiKey": "test-key-placeholder",
    "apiKeyEnv": "SEARCH_API_KEY",
    "baseUrl": "https://search.example.com",
    "enabled": true,
    "provider": "tavily"
  },
  "version": "0.1.0",
  "writing": {
    "reviewMode": "auto",
    "reviewRetries": 1,
    "revisionGate": "strict"
  }
}