{
  "meta": {
    "contract": "R3 质量趋势与回灌幂等（360 号，二轮 P0）——趋势聚合 + FNV 幂等指纹 + 承诺紧迫度（WNW 映射）",
    "invariants": [
      "趋势：章号升序稳定排序（禁 localeCompare）；缺分章保留点位不进均值；averageScore 一位小数；issueCount=critical+warning+info",
      "幂等哈希：FNV-1a 64 UTF-8 hex16，输入 chapter|score|passed|critical|warning|info（缺分 score='-'），不含 recordedAt",
      "重放：同内容指纹仅首次 fresh（保序），不同 recordedAt 同判",
      "紧迫度：目标章 expectedPayoff 显式提取(explicit,窗±2) > targetChapters 书末兜底(inferred,窗[当前,书末]) > 无(unknown)；分档 remaining≤0→100/1–3→80/4–10→60/>10→40，无目标 advancing→40、open→20，fulfilled→0；level ≥80 high / ≥40 medium / 其余 low"
    ]
  },
  "trend": [
    {
      "name": "mixed scored unscored and failing",
      "input": [
        { "chapter": 3, "overallScore": 82, "passed": true, "criticalCount": 0, "warningCount": 2, "infoCount": 1, "recordedAt": "2026-09-12T10:00:00.000Z" },
        { "chapter": 1, "overallScore": 70, "passed": false, "criticalCount": 1, "warningCount": 1, "infoCount": 0, "recordedAt": "2026-09-12T10:01:00.000Z" },
        { "chapter": 2, "passed": true, "criticalCount": 0, "warningCount": 1, "infoCount": 0, "recordedAt": "2026-09-12T10:02:00.000Z" },
        { "chapter": 5, "overallScore": 90, "passed": true, "criticalCount": 0, "warningCount": 0, "infoCount": 0, "recordedAt": "2026-09-12T10:03:00.000Z" }
      ],
      "expected": {
        "points": [
          { "chapter": 1, "overallScore": 70, "passed": false, "issueCount": 2 },
          { "chapter": 2, "overallScore": null, "passed": true, "issueCount": 1 },
          { "chapter": 3, "overallScore": 82, "passed": true, "issueCount": 3 },
          { "chapter": 5, "overallScore": 90, "passed": true, "issueCount": 0 }
        ],
        "scoredChapters": 3,
        "averageScore": 80.7,
        "failingChapters": [1]
      }
    },
    {
      "name": "all unscored yields undefined average",
      "input": [
        { "chapter": 2, "passed": true, "criticalCount": 0, "warningCount": 3, "infoCount": 0, "recordedAt": "2026-09-12T10:00:00.000Z" },
        { "chapter": 1, "passed": true, "criticalCount": 0, "warningCount": 0, "infoCount": 2, "recordedAt": "2026-09-12T10:01:00.000Z" }
      ],
      "expected": {
        "points": [
          { "chapter": 1, "overallScore": null, "passed": true, "issueCount": 2 },
          { "chapter": 2, "overallScore": null, "passed": true, "issueCount": 3 }
        ],
        "scoredChapters": 0,
        "averageScore": null,
        "failingChapters": []
      }
    },
    {
      "name": "empty rows yield empty trend",
      "input": [],
      "expected": {
        "points": [],
        "scoredChapters": 0,
        "averageScore": null,
        "failingChapters": []
      }
    }
  ],
