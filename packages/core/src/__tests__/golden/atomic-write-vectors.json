      "input": {
        "errorCode": "EPERM",
        "attempt": 0
      },
      "expected": true
    },
    {
      "name": "EPERM-attempt1",
      "input": {
        "errorCode": "EPERM",
        "attempt": 1
      },
      "expected": true
    },
    {
      "name": "EPERM-attempt2",
      "input": {
        "errorCode": "EPERM",
        "attempt": 2
      },
      "expected": true
    },
    {
      "name": "EPERM-attempt3",
      "input": {
        "errorCode": "EPERM",
        "attempt": 3
      },
      "expected": false
    },
    {
      "name": "EPERM-attempt5",
      "input": {
        "errorCode": "EPERM",
        "attempt": 5
      },
      "expected": false
    },
    {
      "name": "EBUSY-attempt0",
      "input": {
        "errorCode": "EBUSY",
        "attempt": 0
      },
      "expected": true
    },
    {
      "name": "EBUSY-attempt3",
      "input": {
        "errorCode": "EBUSY",
        "attempt": 3
      },
      "expected": false
    },
    {
      "name": "ENOSPC-attempt0",
      "input": {
        "errorCode": "ENOSPC",
        "attempt": 0
      },
      "expected": false
    },
    {
      "name": "EACCES-attempt0",
      "input": {
        "errorCode": "EACCES",
        "attempt": 0
      },
      "expected": false
    },
    {
      "name": "none-attempt0",
      "input": {
        "errorCode": null,
        "attempt": 0
      },
      "expected": false
    },
    {
      "name": "EPERM-attempt-1",
      "input": {
        "errorCode": "EPERM",
        "attempt": -1
      },
      "expected": false
    }
  ]
}
