        { "type": "message", "version": 1, "sessionId": "s", "seq": 7, "timestamp": 106, "requestId": "r2", "uuid": "u2", "parentUuid": null, "role": "user", "message": { "role": "user", "content": "q2", "timestamp": 106 } },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 8, "timestamp": 107, "requestId": "r2", "uuid": "a2partial", "parentUuid": "u2", "role": "assistant", "message": { "role": "assistant", "content": [{ "type": "text", "text": "partial" }], "stopReason": "stop", "timestamp": 107 } },
        { "type": "request_started", "version": 1, "sessionId": "s", "seq": 9, "timestamp": 108, "requestId": "r3", "input": "q3" },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 10, "timestamp": 109, "requestId": "r3", "uuid": "u3", "parentUuid": null, "role": "user", "message": { "role": "user", "content": "q3", "timestamp": 109 } },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 11, "timestamp": 110, "requestId": "r3", "uuid": "a3", "parentUuid": "u3", "role": "assistant", "message": { "role": "assistant", "content": [{ "type": "text", "text": "ans3" }], "stopReason": "stop", "timestamp": 110 } },
        { "type": "request_committed", "version": 1, "sessionId": "s", "seq": 12, "timestamp": 111, "requestId": "r3" }
      ],
      "expected": {
