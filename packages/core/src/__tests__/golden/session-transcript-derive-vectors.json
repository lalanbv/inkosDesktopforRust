        "scanMessages": [
          { "role": "user", "content": "q1" },
          { "role": "assistant", "content": "ans1" },
          { "role": "user", "content": "q3" },
          { "role": "assistant", "content": "ans3" }
        ],
        "deriveRoles": ["user", "assistant", "user", "assistant"]
      }
    },
