{
  "version": 1,
  "comment": "R43/565 号会话 transcript derive/restore 双端 golden。TS=packages/core session-transcript-restore（committedMessageEvents + restoreCommittedDialogueScan + deriveBookSessionFromTranscript），Rust=engine-rs session_restore 同名同构（tests/golden_session_transcript_derive.rs）。锁定：committed 过滤（未提交轮整体排除=中断尾部确定性修复：撕裂尾剔除且后续轮不受影响）、kind 过滤（只作用于模型面 committedMessageEvents(kind)/scan——display derive 不传 kind，展示面全量，双端同构不对称）、工具轮对话排除与 legacy 无 kind 轮 user 保留、空文本 assistant 丢弃。事件 JSON 为 wire 形态逐行落盘后双端解析（serde TranscriptEvent / zod TranscriptEventSchema 必须同收）。内容全 ASCII；scanMessages.content=文本块拍平。改向量必须双端同批。",
  "cases": [
    {
      "name": "committed-turns-basic",
      "deriveSessionKind": null,
      "events": [
        { "type": "session_created", "version": 1, "sessionId": "s", "seq": 1, "timestamp": 100, "bookId": null, "title": null, "createdAt": 100, "updatedAt": 100 },
        { "type": "request_started", "version": 1, "sessionId": "s", "seq": 2, "timestamp": 101, "requestId": "r1", "input": "hello" },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 3, "timestamp": 102, "requestId": "r1", "uuid": "u1", "parentUuid": null, "role": "user", "message": { "role": "user", "content": "hello", "timestamp": 102 } },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 4, "timestamp": 103, "requestId": "r1", "uuid": "a1", "parentUuid": "u1", "role": "assistant", "message": { "role": "assistant", "content": [{ "type": "text", "text": "hi there" }], "stopReason": "stop", "timestamp": 103 } },
        { "type": "request_committed", "version": 1, "sessionId": "s", "seq": 5, "timestamp": 104, "requestId": "r1" },
        { "type": "request_started", "version": 1, "sessionId": "s", "seq": 6, "timestamp": 105, "requestId": "r2", "input": "how are you" },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 7, "timestamp": 106, "requestId": "r2", "uuid": "u2", "parentUuid": null, "role": "user", "message": { "role": "user", "content": "how are you", "timestamp": 106 } },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 8, "timestamp": 107, "requestId": "r2", "uuid": "a2", "parentUuid": "u2", "role": "assistant", "message": { "role": "assistant", "content": [{ "type": "text", "text": "fine" }], "stopReason": "stop", "timestamp": 107 } },
        { "type": "request_committed", "version": 1, "sessionId": "s", "seq": 9, "timestamp": 108, "requestId": "r2" }
      ],
      "expected": {
        "committedUuids": ["u1", "a1", "u2", "a2"],
        "scanMessages": [
          { "role": "user", "content": "hello" },
          { "role": "assistant", "content": "hi there" },
          { "role": "user", "content": "how are you" },
          { "role": "assistant", "content": "fine" }
        ],
        "deriveRoles": ["user", "assistant", "user", "assistant"]
      }
    },
    {
      "name": "interrupted-tail-excluded-next-turn-clean",
      "deriveSessionKind": null,
      "events": [
        { "type": "session_created", "version": 1, "sessionId": "s", "seq": 1, "timestamp": 100, "bookId": null, "title": null, "createdAt": 100, "updatedAt": 100 },
        { "type": "request_started", "version": 1, "sessionId": "s", "seq": 2, "timestamp": 101, "requestId": "r1", "input": "q1" },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 3, "timestamp": 102, "requestId": "r1", "uuid": "u1", "parentUuid": null, "role": "user", "message": { "role": "user", "content": "q1", "timestamp": 102 } },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 4, "timestamp": 103, "requestId": "r1", "uuid": "a1", "parentUuid": "u1", "role": "assistant", "message": { "role": "assistant", "content": [{ "type": "text", "text": "ans1" }], "stopReason": "stop", "timestamp": 103 } },
