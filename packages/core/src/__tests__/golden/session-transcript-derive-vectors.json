    {
      "name": "kind-filter-excludes-other-kind",
      "deriveSessionKind": "chat",
      "events": [
        { "type": "session_created", "version": 1, "sessionId": "s", "seq": 1, "timestamp": 100, "bookId": null, "sessionKind": "book", "title": null, "createdAt": 100, "updatedAt": 100 },
        { "type": "request_started", "version": 1, "sessionId": "s", "seq": 2, "timestamp": 101, "requestId": "r1", "sessionKind": "book", "input": "q1" },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 3, "timestamp": 102, "requestId": "r1", "uuid": "u1", "parentUuid": null, "role": "user", "message": { "role": "user", "content": "q1", "timestamp": 102 } },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 4, "timestamp": 103, "requestId": "r1", "uuid": "a1", "parentUuid": "u1", "role": "assistant", "message": { "role": "assistant", "content": [{ "type": "text", "text": "ans1" }], "stopReason": "stop", "timestamp": 103 } },
        { "type": "request_committed", "version": 1, "sessionId": "s", "seq": 5, "timestamp": 104, "requestId": "r1" }
      ],
      "expected": {
        "committedUuids": [],
        "scanMessages": [],
        "deriveRoles": ["user", "assistant"],
        "note": "kind 过滤只作用于模型面（committed/scan）；display derive 不传 kind，展示面全量（双端同构不对称）。"
      }
    },
    {
      "name": "kind-filter-includes-same-kind",
      "deriveSessionKind": "book",
      "events": [
        { "type": "session_created", "version": 1, "sessionId": "s", "seq": 1, "timestamp": 100, "bookId": null, "sessionKind": "book", "title": null, "createdAt": 100, "updatedAt": 100 },
        { "type": "request_started", "version": 1, "sessionId": "s", "seq": 2, "timestamp": 101, "requestId": "r1", "sessionKind": "book", "input": "q1" },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 3, "timestamp": 102, "requestId": "r1", "uuid": "u1", "parentUuid": null, "role": "user", "message": { "role": "user", "content": "q1", "timestamp": 102 } },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 4, "timestamp": 103, "requestId": "r1", "uuid": "a1", "parentUuid": "u1", "role": "assistant", "message": { "role": "assistant", "content": [{ "type": "text", "text": "ans1" }], "stopReason": "stop", "timestamp": 103 } },
