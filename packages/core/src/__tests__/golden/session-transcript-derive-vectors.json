        { "type": "message", "version": 1, "sessionId": "s", "seq": 4, "timestamp": 103, "requestId": "r1", "uuid": "at", "parentUuid": "u1", "role": "assistant", "message": { "role": "assistant", "content": [{ "type": "toolCall", "id": "c1", "name": "ls", "arguments": {} }], "stopReason": "toolUse", "timestamp": 103 } },
