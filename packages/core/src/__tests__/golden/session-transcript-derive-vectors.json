    {
      "name": "tool-round-display-cards-and-scan-exclusion",
      "deriveSessionKind": "book",
      "events": [
        { "type": "session_created", "version": 1, "sessionId": "s", "seq": 1, "timestamp": 100, "bookId": null, "sessionKind": "book", "title": null, "createdAt": 100, "updatedAt": 100 },
        { "type": "request_started", "version": 1, "sessionId": "s", "seq": 2, "timestamp": 101, "requestId": "r1", "sessionKind": "book", "input": "scan it" },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 3, "timestamp": 102, "requestId": "r1", "uuid": "u1", "parentUuid": null, "role": "user", "message": { "role": "user", "content": "scan it", "timestamp": 102 } },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 4, "timestamp": 103, "requestId": "r1", "uuid": "at", "parentUuid": "u1", "role": "assistant", "message": { "role": "assistant", "content": [{ "type": "toolCall", "id": "c1", "name": "grep", "arguments": { "q": "canon" } }], "stopReason": "toolUse", "timestamp": 103 } },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 5, "timestamp": 104, "requestId": "r1", "uuid": "tr", "parentUuid": "at", "role": "toolResult", "toolCallId": "c1", "message": { "role": "toolResult", "toolCallId": "c1", "toolName": "grep", "content": [{ "type": "text", "text": "found" }], "isError": false, "timestamp": 104 } },
        { "type": "message", "version": 1, "sessionId": "s", "seq": 6, "timestamp": 105, "requestId": "r1", "uuid": "af", "parentUuid": null, "role": "assistant", "message": { "role": "assistant", "content": [{ "type": "text", "text": "done" }], "stopReason": "stop", "timestamp": 105 } },
        { "type": "request_committed", "version": 1, "sessionId": "s", "seq": 7, "timestamp": 106, "requestId": "r1" }
      ],
      "expected": {
        "committedUuids": ["u1", "at", "tr", "af"],
        "scanMessages": [],
        "deriveRoles": ["user", "assistant"],
        "deriveToolCardCount": 1,
        "note": "工具卡折叠挂到最终文本 assistant（pending attach 到 last assistant），非独立卡消息。"
      }
    },
