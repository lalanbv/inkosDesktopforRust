  "contract": {
    "kinds": [
      "writing",
      "review",
      "repair",
      "detect",
      "analysis"
    ],
    "fields": [
      "model",
      "service",
      "temperature",
      "maxTokens"
    ],
    "levels": [
      "book-task",
      "book-defaults",
      "project-task",
      "project-defaults",
      "fallback"
    ],
    "migrationCompat": "absent-routing-resolves-to-fallback",
    "chain": {
      "chainFields": [
        "retryCount",
        "backupModels"
      ],
      "maxAttempts": 4,
      "maxBackupModels": 3,
      "retryCountRange": [
        1,
        5
      ],
      "defaultRetryCount": 1,
      "dedupe": "exact-match-against-existing-attempts"
    }
  },
  "chain": [
    {
      "name": "chain-full-with-dedupe",
      "input": {
        "task": "writing",
        "bookRouting": {
          "tasks": {
            "writing": {
              "model": "writer-x",
              "retryCount": 2,
              "backupModels": [
                "writer-y",
                "writer-x",
                "writer-z"
              ]
            }
          }
        },
        "projectRouting": null
      },
      "expected": {
        "task": "writing",
        "attempts": [
          {
            "model": "writer-x",
            "service": "moonshot"
          },
          {
            "model": "writer-y"
          },
          {
            "model": "writer-z"
          }
        ],
        "retryCount": 2
      }
    },
    {
      "name": "chain-project-defaults-backup-inherit",
      "input": {
        "task": "review",
        "bookRouting": {
          "tasks": {
