      },
      "expected": 1.0
    },
    {
      "name": "near-duplicate-goal-vs-summary",
      "input": {
        "a": "林秋拿到账本并当众揭穿厂主",
        "b": "林秋拿到账本，并当众揭穿了厂主"
      },
      "expected": 0.88
    },
    {
      "name": "unrelated",
      "input": {
        "a": "运送军火进城",
        "b": "师门血案真相浮现"
      },
      "expected": 0.0
    },
    {
      "name": "partial-overlap",
      "input": {
        "a": "账本",
        "b": "账本下落"
      },
      "expected": 0.5
    },
    {
      "name": "short-degenerate-equal",
      "input": {
        "a": "账",
        "b": "账"
      },
      "expected": 1.0
    },
    {
      "name": "short-degenerate-diff",
      "input": {
        "a": "账",
        "b": "刀"
      },
      "expected": 0.0
    },
    {
      "name": "empty-a",
      "input": {
        "a": "！",
        "b": "拿到账本"
      },
      "expected": 0.0
    }
  ],
  "evaluate": [
    {
      "name": "repeat-exact-goal-echoes-summary",
      "input": {
        "goal": "林秋拿到账本",
