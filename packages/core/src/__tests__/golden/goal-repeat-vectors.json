        ],
        "threshold": null
      },
      "expected": {
        "repeat": true,
        "maxSimilarity": 0.8148,
        "exactMatch": false
      }
    },
    {
      "name": "clean-new-goal",
      "input": {
        "goal": "护送账本出城并甩开追兵",
        "references": [
          "林秋拿到账本，当众揭穿厂主",
          "师门血案浮出水面"
        ],
        "threshold": null
      },
      "expected": {
        "repeat": false,
        "maxSimilarity": 0.0952,
        "exactMatch": false
      }
    },
    {
      "name": "empty-references-first-chapter",
      "input": {
        "goal": "拿到账本",
