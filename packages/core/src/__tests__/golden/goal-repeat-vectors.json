          "林秋拿到账本",
          "别的线"
        ],
        "threshold": null
      },
      "expected": {
        "repeat": true,
        "maxSimilarity": 1.0,
        "exactMatch": true
      }
    },
    {
      "name": "repeat-high-similarity",
      "input": {
        "goal": "林秋拿到账本并当众揭穿厂主",
        "references": [
          "上章：林秋拿到账本，并当众揭穿了厂主",
