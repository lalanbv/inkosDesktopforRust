{
  "_header": "R28 章节目标防复读门共享向量（399 号，v5 五轮规划 P1）。唯一事实源本文件；TS 断言 src/__tests__/golden-goal-repeat.test.ts，Rust 差分 engine-rs/tests/golden_goal_repeat_diff.rs。归一化=ASCII 小写+保留字母/数字/汉字；相似度=字符 bigram 集合 Dice，4 位小数向下截断；判定=exactMatch 或 maxSimilarity≥阈值（缺省 0.8）；空对照/空 goal 恒 false。",
  "normalize": [
    {
      "name": "zh-punct-and-whitespace",
      "input": "林秋 真正拿到账本，并当众揭穿厂主！",
      "expected": "林秋真正拿到账本并当众揭穿厂主"
    },
    {
      "name": "ascii-case-folds",
      "input": "Recover The STASH",
      "expected": "recoverthestash"
    },
    {
      "name": "fullwidth-latin-dropped",
      "input": "ｄｅｍｏ 目标",
      "expected": "目标"
    },
    {
      "name": "digits-kept",
      "input": "第 3 次谈判！",
      "expected": "第3次谈判"
    },
    {
      "name": "kana-not-kept",
      "input": "目標ダ",
      "expected": "目標"
    },
    {
      "name": "empty",
      "input": "。！ 　",
      "expected": ""
    }
  ],
  "similarity": [
    {
      "name": "identical",
      "input": {
        "a": "拿到账本并揭穿厂主",
