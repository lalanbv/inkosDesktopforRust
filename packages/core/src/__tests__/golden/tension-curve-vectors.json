{
  "meta": {
    "contract": "R2 张力曲线（358 号，二轮 P0）——TENSION_METRICS 节解析 + 章级点列聚合 + 启发式告警",
    "invariants": [
      "解析：=== TENSION_METRICS === 节，JSON 形态优先、key:value 行式回退（中文冒号兼容）；任一字段缺失/非法整节放弃返回 null",
      "数值 clamp 到 1–10 整数（round 后夹紧）",
      "曲线：仅收双分齐全的章，按章号升序",
      "告警：flat-middle=中段（ceil(0.3N)–floor(0.7N)）conflict 极差窗口；climax-crowding=尾段（floor(0.75N)+1 起）reveal≥8 高点数 ≥3 且 > 早段高点数；weak-hook-streak=连续 3 章 reveal≤3；points 为空返回空数组"
    ],
    "defaults": {
      "flatWindow": 4,
      "flatMaxRange": 1,
      "middleStart": 0.3,
      "middleEnd": 0.7,
      "climaxMinLevel": 8,
      "climaxWindow": 0.25,
      "climaxMinCount": 3,
      "weakLevel": 3,
      "weakWindow": 3
    }
  },
  "parse": [
    {
      "name": "key-value lines with zh colon between sibling tags",
      "input": "=== CHAPTER_SUMMARY ===\n主角在废墟中发现怀表。\n=== TENSION_METRICS ===\nconflictLevel：7\nrevealLevel：3\n=== UPDATED_HOOKS ===\n- h1 推进",
      "expected": { "conflictLevel": 7, "revealLevel": 3 }
    },
    {
      "name": "json fenced payload",
      "input": "=== TENSION_METRICS ===\n```json\n{\"conflictLevel\": 8, \"revealLevel\": 9}\n```\n=== UPDATED_HOOKS ===\n- h2 回收",
      "expected": { "conflictLevel": 8, "revealLevel": 9 }
    },
    {
      "name": "out-of-range values clamp into 1-10",
      "input": "=== TENSION_METRICS ===\nconflictLevel: 15\nrevealLevel: 0\n",
      "expected": { "conflictLevel": 10, "revealLevel": 1 }
    },
    {
      "name": "missing revealLevel abandons whole section",
      "input": "=== TENSION_METRICS ===\nconflictLevel: 6\n",
      "expected": null
    },
    {
      "name": "no section yields undefined",
      "input": "=== POST_SETTLEMENT ===\n本章无张力评分节。",
      "expected": null
    },
    {
      "name": "fractional values round to integers",
      "input": "=== TENSION_METRICS ===\nconflictLevel: 6.4\nrevealLevel: 2.6\n",
      "expected": { "conflictLevel": 6, "revealLevel": 3 }
    }
  ],
  "curve": [
    {
      "name": "unsorted rows skip unscored chapters",
      "input": [
        { "chapter": 3 },
        { "chapter": 1, "conflictLevel": 7, "revealLevel": 3 },
        { "chapter": 5, "conflictLevel": 6, "revealLevel": 8 },
        { "chapter": 2 },
        { "chapter": 4, "conflictLevel": 9, "revealLevel": 1 }
      ],
      "expected": {
        "points": [
          { "chapter": 1, "conflictLevel": 7, "revealLevel": 3 },
          { "chapter": 4, "conflictLevel": 9, "revealLevel": 1 },
          { "chapter": 5, "conflictLevel": 6, "revealLevel": 8 }
        ],
        "scoredChapters": 3,
        "unscoredChapters": 2
      }
    },
    {
