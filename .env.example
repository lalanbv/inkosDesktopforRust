# InkOS Environment Configuration
# Copy to .env and fill in your values

# LLM Provider (openai, anthropic, custom)
INKOS_LLM_PROVIDER=openai

# API Base URL (OpenAI-compatible endpoint)
INKOS_LLM_BASE_URL=https://api.openai.com/v1

# API Key
# API Key（占位符去凭据形态：855 号纪律——示例文件不写凭据前缀特征字面量）
INKOS_LLM_API_KEY=test-key-placeholder

# Model name
INKOS_LLM_MODEL=gpt-4o

# Notifications (optional)
INKOS_TELEGRAM_BOT_TOKEN=
INKOS_TELEGRAM_CHAT_ID=
INKOS_FEISHU_WEBHOOK_URL=
INKOS_WECOM_WEBHOOK_URL=

# ── 网络请求预算（898-925 号；各链超时错误带标签可溯源，默认值见 README「引擎环境变量」表）──
# INKOS_LLM_REQUEST_TIMEOUT_MS=300000
# INKOS_NOTIFY_TIMEOUT_MS=15000
# INKOS_COVER_REQUEST_TIMEOUT_MS=600000
# INKOS_DETECT_HTTP_TIMEOUT_MS=30000

# ── 封面下载 origin 策略（900 号；模型返回 URL 的环回/私网默认拒绝）──
# INKOS_COVER_DOWNLOAD_ORIGIN_POLICY=strict
# INKOS_COVER_DOWNLOAD_EXTRA_ORIGINS=
