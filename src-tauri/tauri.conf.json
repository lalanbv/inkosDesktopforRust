{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inkosDesktop",
  "version": "0.1.0",
  "identifier": "com.inkos.desktop",
  "build": {
    "frontendDist": "picker"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "inkosDesktop",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [],
    "resources": ["engine"]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_ED25519_PUBKEY_FROM_M3E",
      "endpoints": [
        "https://github.com/lalanbv/inkosDesktopforRust/releases/latest/download/latest.json"
      ]
    }
  }
}
